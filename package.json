{
  "name": "@alternative-design-and-media/rentman-api-connector",
  "version": "2.6.0",
  "description": "Type-safe Rentman REST API client for Node.js and edge runtimes (Cloudflare Workers). Synced to OAS v1.7.0.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "generate-rentman-custom-fields": "./dist/scripts/generate-custom-fields.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "llms.txt",
    "llms-full.txt"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "tsup --watch --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "docs:ai": "node scripts/generate-ai-docs.mjs",
    "prepublishOnly": "npm run typecheck && npm run build",
    "generate:custom-fields": "tsx scripts/generate-custom-fields.ts"
  },
  "keywords": [
    "rentman",
    "api",
    "client",
    "typescript",
    "mcp",
    "cloudflare-workers"
  ],
  "author": "Alternative Design and Media",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alternative-Design-And-Media/rentman-api-connector.git"
  },
  "bugs": {
    "url": "https://github.com/Alternative-Design-And-Media/rentman-api-connector/issues"
  },
  "homepage": "https://github.com/Alternative-Design-And-Media/rentman-api-connector#readme",
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.22.2",
    "typescript": "^5.4.0",
    "vitest": "^4.1.6"
  }
}
